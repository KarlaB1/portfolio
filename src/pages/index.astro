---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FrameLabel from '../components/FrameLabel.astro';
import WorkCard from '../components/WorkCard.astro';
import CreativeCard from '../components/CreativeCard.astro';
import { site } from '../data/site';
import { getWork, getCreative, pad } from '../lib/content';

const work = await getWork();
const featuredWork = (work.some((w) => w.data.featured) ? work.filter((w) => w.data.featured) : work);
const creative = await getCreative();
const creativeStrip = (creative.some((c) => c.data.featured) ? creative.filter((c) => c.data.featured) : creative).slice(0, 6);

// Hero storyboard: three frames taken from real project covers.
const frames = [...featuredWork.map((w) => w.data), ...creativeStrip.map((c) => c.data)].slice(0, 3);

const principles = [
  {
    word: 'Construir',
    text: 'Vengo de la ingeniería de software: diseño pensando en cómo se va a implementar y hablo el idioma de los desarrolladores con los que trabajo.',
  },
  {
    word: 'Diseñar',
    text: 'Mi enfoque es UX/UI: entender lo que la gente necesita, estructurarlo y dar forma a interfaces donde el siguiente paso sea claro.',
  },
  {
    word: 'Contar',
    text: 'Estudiar narrativas multimedia, y hacer fotografía, video y cómic, me entrenó el ojo para la composición, el ritmo y la secuencia.',
  },
];
---

<BaseLayout>
  <!-- 00 · Hero -->
  <section class="hero wrap" aria-labelledby="hero-title">
    <p class="hero__kicker mono">
      <span class="frame-label__n">00</span>
      <span>{site.role}</span>
      <span class="muted">{site.tagline}</span>
    </p>
    <h1 id="hero-title" class="display hero__title" set:html={site.heroStatement} />

    <div class="hero__foot">
      <div class="hero__actions">
        <a class="btn btn--solid" href="#work">Ver proyectos <span class="arrow" aria-hidden="true">↓</span></a>
        <a class="btn" href="/about/">Sobre mí</a>
      </div>
      {
        frames.length > 0 && (
          <ol role="list" class="storyboard" aria-hidden="true">
            {frames.map((f, i) => (
              <li class="storyboard__frame">
                <div class="panel">
                  <Image src={f.cover} alt="" widths={[240, 400]} sizes="12rem" loading="eager" />
                </div>
                <span class="mono">{pad(i + 1)}</span>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>

  <!-- 01 · Selected work -->
  <section class="section wrap" id="work" aria-labelledby="work-title">
    <FrameLabel n="01" label="Proyectos UX/UI" id="work-title" aside={`${work.length} ${work.length === 1 ? 'caso de estudio' : 'casos de estudio'}`} />
    <div class="work-list">
      {featuredWork.map((entry, i) => <WorkCard entry={entry} n={pad(i + 1)} size="large" />)}
    </div>
    {work.length > featuredWork.length && (
      <p class="more"><a class="btn" href="/work/">Todos los proyectos <span class="arrow" aria-hidden="true">→</span></a></p>
    )}
  </section>

  <!-- 02 · How I work -->
  <section class="section wrap" aria-labelledby="how-title">
    <FrameLabel n="02" label="Cómo trabajo" id="how-title" />
    <ol role="list" class="principles">
      {
        principles.map((p, i) => (
          <li class="principle" data-reveal style={`transition-delay:${i * 80}ms`}>
            <span class="mono frame-label__n">{pad(i + 1)}</span>
            <h3 class="h1 principle__word">{p.word}</h3>
            <p class="muted">{p.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 03 · Creative -->
  {
    creativeStrip.length > 0 && (
      <section class="section wrap" aria-labelledby="creative-title">
        <FrameLabel n="03" label="Trabajo creativo" id="creative-title" aside="Fotografía · Video · Cómic" />
        <p class="lead creative-intro">
          Fuera de la interfaz, trabajo con imagen y secuencia: fotografía, video y cómic.
        </p>
        <div class="strip">
          {creativeStrip.map((entry) => (
            <CreativeCard entry={entry} sizes="(min-width: 64rem) 22vw, 70vw" />
          ))}
        </div>
        <p class="more"><a class="btn" href="/creative/">Todo el trabajo creativo <span class="arrow" aria-hidden="true">→</span></a></p>
      </section>
    )
  }

  <!-- 04 · Contact -->
  <section class="section wrap contact" id="contact" aria-labelledby="contact-title">
    <FrameLabel n="04" label="Contacto" as="p" />
    <h2 id="contact-title" class="display contact__title">
      Hablemos de <em>lo que sigue.</em>
    </h2>
    <p class="contact__links">
      {site.email && <a class="btn btn--solid" href={`mailto:${site.email}`}>{site.email}</a>}
      {site.social.filter((s) => s.href).map((s) => <a class="btn" href={s.href} rel="me noopener">{s.label}</a>)}
      {site.cvUrl && <a class="btn" href={site.cvUrl}>CV (PDF)</a>}
    </p>
  </section>
</BaseLayout>

<style>
  .hero { padding-block: clamp(3rem, 8vw, 7rem) var(--space); }
  .hero__kicker { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin-bottom: clamp(1.5rem, 4vw, 3rem); }
  .hero__title { max-width: 18ch; }
  .hero__foot {
    display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between;
    gap: 2rem; margin-top: clamp(2.5rem, 6vw, 5rem);
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .storyboard { display: grid; grid-template-columns: repeat(3, minmax(0, 11rem)); gap: 0.6rem; }
  .storyboard__frame .panel { aspect-ratio: 3 / 4; }
  .storyboard__frame span { display: block; margin-top: 0.4rem; color: var(--ink-2); }
  .storyboard__frame:nth-child(2) { transform: translateY(-1.5rem); }
  .storyboard__frame .panel { box-shadow: 0 1.5rem 3rem -1.5rem rgb(0 0 0 / 0.6); }

  @media (max-width: 40rem) {
    .storyboard { grid-template-columns: repeat(3, 1fr); width: 100%; }
    .storyboard__frame:nth-child(2) { transform: none; }
  }

  .work-list { display: grid; gap: clamp(3.5rem, 8vw, 7rem); }
  .more { margin-top: clamp(2.5rem, 5vw, 4rem); }

  .principles { display: grid; gap: 2.5rem var(--gutter); }
  @media (min-width: 48rem) { .principles { grid-template-columns: repeat(3, 1fr); } }
  .principle { border-left: 1px solid var(--line); padding-left: 1.25rem; }
  .principle__word { margin-block: 0.75rem 1rem; }
  .principle p { max-width: 26rem; }

  .creative-intro { margin-bottom: 2.5rem; }
  /* Horizontal strip on mobile (swipe), grid on desktop. */
  .strip {
    display: grid; grid-auto-flow: column; grid-auto-columns: 70%; gap: 1rem;
    overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 1rem;
  }
  .strip > :global(*) { scroll-snap-align: start; }
  @media (min-width: 64rem) {
    .strip { grid-auto-flow: row; grid-template-columns: repeat(4, 1fr); overflow: visible; }
  }

  .contact__title { max-width: 14ch; }
  .contact__links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.5rem; }
</style>
