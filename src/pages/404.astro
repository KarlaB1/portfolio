---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada">
  <section class="wrap section">
    <p class="frame-label"><span class="frame-label__n">404</span><span>Cuadro perdido</span></p>
    <h1 class="display">Este cuadro <em>no está en la secuencia.</em></h1>
    <p style="margin-top:2.5rem"><a class="btn btn--solid" href="/">Volver al inicio <span class="arrow" aria-hidden="true">→</span></a></p>
  </section>
</BaseLayout>
