---
// Lightweight video: shows a poster and only loads the player on click,
// so embeds cost nothing until the visitor asks for them.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  poster: ImageMetadata;
  provider: 'youtube' | 'vimeo' | 'file';
  id?: string;
  src?: string;
  captions?: string;
}
const { title, poster, provider, id, src, captions } = Astro.props;

const embed =
  provider === 'youtube' && id
    ? `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`
    : provider === 'vimeo' && id
      ? `https://player.vimeo.com/video/${id}?autoplay=1&dnt=1`
      : undefined;
// Vertical footage (phone / TikTok) keeps its shape instead of being boxed into 16:9.
const vertical = poster.height > poster.width;
---

<div class:list={['video', { 'video--vertical': vertical }]}>
  {
    provider === 'file' && src ? (
      <video controls preload="none" playsinline poster={poster.src}>
        <source src={src} />
        {captions && <track kind="captions" src={captions} srclang="es" label="Subtítulos" default />}
      </video>
    ) : embed ? (
      <div class="video__facade" data-video={embed} data-title={title}>
        <Image src={poster} alt="" widths={[800, 1200, 1600]} sizes="100vw" />
        <button type="button" class="video__play mono">
          <span aria-hidden="true">▶</span> Reproducir video<span class="visually-hidden">: {title}</span>
        </button>
      </div>
    ) : (
      <div class="video__facade">
        <Image src={poster} alt="" widths={[800, 1200]} sizes="100vw" />
        <p class="video__play mono">Video pendiente</p>
      </div>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = el.dataset.video!;
      iframe.title = el.dataset.title ?? 'Video';
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .video { aspect-ratio: 16 / 9; background: var(--paper-2); border-radius: var(--radius); overflow: hidden; position: relative; }
  .video--vertical { aspect-ratio: 9 / 16; max-width: min(24rem, 100%); max-height: 85vh; margin-inline: auto; }
  .video video { object-fit: contain; background: #000; }
  .video video, .video__facade, .video :global(iframe) { width: 100%; height: 100%; border: 0; }
  .video__facade { position: relative; }
  .video__facade :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .video__play {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    background: var(--paper); color: var(--ink); border: 1px solid var(--ink);
    padding: 1rem 1.4rem; border-radius: 999px; cursor: pointer; font: inherit;
    font-family: var(--font-mono); font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.04em;
    transition: background 0.25s var(--ease), color 0.25s var(--ease);
  }
  button.video__play:hover { background: var(--accent); color: var(--paper); border-color: var(--accent); }
</style>
