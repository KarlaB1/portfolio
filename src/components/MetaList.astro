---
// Project facts (role, year, tools...). Empty values are skipped.
interface Props { items: { label: string; value?: string | number }[] }
const items = Astro.props.items.filter((i) => i.value !== undefined && i.value !== '');
---

<dl class="meta">
  {
    items.map((i) => (
      <div>
        <dt class="mono muted">{i.label}</dt>
        <dd>{i.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); border-top: 1px solid var(--line); }
  .meta > div { padding: 0.9rem 1rem 1.1rem 0; border-bottom: 1px solid var(--line-soft); }
  .meta dt { margin-bottom: 0.35rem; }
</style>
